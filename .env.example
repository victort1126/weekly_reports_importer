# ---------------------------------------------------------------------------
# Slack (api.slack.com/apps -> your app -> Basic Information / OAuth & Permissions / Socket Mode)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Optional: restrict processing to a single private channel ID (e.g. C0123456789).
# Leave empty to process messages in every private channel the bot has been invited to.
SLACK_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Azure OpenAI (your GPT-5 deployment)
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------------------------------------------------------------------------
# Google Sheets (OAuth Desktop-app flow -- see README.md for setup)
# ---------------------------------------------------------------------------
# Path to the OAuth client JSON downloaded from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_PATH=credentials/oauth_client.json
# Path where the app will persist the refresh token after the first consent.
GOOGLE_TOKEN_PATH=credentials/token.json
# The spreadsheet ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Optional overrides if your tab names differ from the defaults.
ROSTER_SHEET_NAME=Roster
REPORT_LOG_SHEET_NAME=Report Log
